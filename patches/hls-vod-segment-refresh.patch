@@ -1785,6 +1880,11 @@ restart:
         if (ret < 0) {
             if (ff_check_interrupt(c->interrupt_callback))
                 return AVERROR_EXIT;
+            if (!vod_refreshed) {
+                vod_refreshed = 1;
+                if (refresh_vod_playlist(c, v, ret))
+                    goto restart;
+            }
             av_log(v->parent, AV_LOG_WARNING, "Failed to open segment %"PRId64" of playlist %d\n",
                    v->cur_seq_no,
                    v->index);
@@ -1794,12 +1894,14 @@ restart:
                        v->index);
                 v->cur_seq_no++;
                 segment_retries = 0;
+                vod_refreshed = 0;
             } else {
                 segment_retries++;
             }
             goto restart;
         }
         segment_retries = 0;
+        vod_refreshed = 0;
         just_opened = 1;
         v->input_read_done = 0;
     }
@@ -2304,6 +2406,10 @@ static int hls_read_header(AVFormatContext *s)
         av_log(s, AV_LOG_WARNING, "Empty playlist\n");
         return AVERROR_EOF;
     }
+    /* A media playlist opened directly is registered under the redirected
+     * URL; remember the one we were given. */
+    if (c->n_playlists == 1 && c->playlists[0]->n_segments > 0)
+        av_strlcpy(c->playlists[0]->orig_url, s->url, sizeof(c->playlists[0]->orig_url));
     /* If the playlist only contained playlists (Master Playlist),
      * parse each individual playlist. */
     if (c->n_playlists > 1 || c->playlists[0]->n_segments == 0) {
@@ -3065,6 +3171,8 @@ static const AVOption hls_options[] = {
         OFFSET(seg_format_opts), AV_OPT_TYPE_DICT, {.str = NULL}, 0, 0, FLAGS},
     {"seg_max_retry", "Maximum number of times to reload a segment on error.",
      OFFSET(seg_max_retry), AV_OPT_TYPE_INT, {.i64 = 0}, 0, INT_MAX, FLAGS},
+    {"vod_refresh_on_segment_error", "Reload a finished playlist from its original URL when a segment answers 401, 403, 404 or another 4xx except 400 and 429 (410 included)",
+     OFFSET(vod_refresh_on_segment_error), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, FLAGS},
     {NULL}
 };
 

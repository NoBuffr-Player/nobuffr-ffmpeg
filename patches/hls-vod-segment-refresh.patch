+/*
+ * Some providers serve a finished (VOD) playlist whose segment URLs carry a
+ * token that expires some time after the playlist was fetched; the segments
+ * then answer 4xx while a new request to the playlist URL yields fresh ones.
+ * On such an error, load the playlist again from the URL it was opened with,
+ * so that redirects and token issuing happen again, and keep the position.
+ * Returns 1 if the playlist was replaced and the segment should be retried,
+ * 0 if not (the caller then falls back to skipping the segment).
+ */
+static int refresh_vod_playlist(HLSContext *c, struct playlist *v, int err)
+{
+    int64_t now, elapsed = 0, pos = 0;
+    int64_t old_start = v->start_seq_no;
+    int old_n = v->n_segments;
+    int64_t n_before = av_clip64(v->cur_seq_no - v->start_seq_no, 0, v->n_segments);
+    int ret, i;
+
+    if (!c->vod_refresh_on_segment_error || !v->finished || v->is_subtitle)
+        return 0;
+    switch (err) {
+    case AVERROR_HTTP_UNAUTHORIZED:
+    case AVERROR_HTTP_FORBIDDEN:
+    case AVERROR_HTTP_NOT_FOUND:
+    case AVERROR_HTTP_OTHER_4XX: /* includes 410 Gone, which http.c does not
+                                  * tell apart; 400 and 429 have own codes */
+        break;
+    default:
+        return 0;
+    }
+
+    now = av_gettime_relative();
+    if (v->n_vod_refresh >= VOD_REFRESH_MAX_PER_WINDOW &&
+        now - v->vod_refresh_time[v->n_vod_refresh % VOD_REFRESH_MAX_PER_WINDOW] < VOD_REFRESH_WINDOW_US) {
+        av_log(v->parent, AV_LOG_WARNING,
+               "Playlist %d: too many refreshes, not refreshing again\n", v->index);
+        return 0;
+    }
+    v->vod_refresh_time[v->n_vod_refresh % VOD_REFRESH_MAX_PER_WINDOW] = now;
+    v->n_vod_refresh++;
+
+    for (i = 0; i < n_before; i++)
+        elapsed += v->segments[i]->duration;
+
+    av_log(v->parent, AV_LOG_WARNING,
+           "Segment %"PRId64" of playlist %d failed (%s), reloading the VOD playlist\n",
+           v->cur_seq_no, v->index, av_err2str(err));
+    v->vod_refreshing = 1;
+    ret = parse_playlist(c, v->orig_url[0] ? v->orig_url : v->url, v, NULL);
+    v->vod_refreshing = 0;
+    if (ret < 0) {
+        av_log(v->parent, AV_LOG_WARNING, "Failed to reload VOD playlist %d: %s\n",
+               v->index, av_err2str(ret));
+        return 0;
+    }
+
+    /* Keep the position: by sequence number when the list looks the same,
+     * else by the playback time covered by the segments already consumed. */
+    if (v->start_seq_no != old_start || v->n_segments != old_n) {
+        for (i = 0; i < v->n_segments && pos + v->segments[i]->duration <= elapsed; i++)
+            pos += v->segments[i]->duration;
+        v->cur_seq_no = v->start_seq_no + i;
+    }
+    return v->finished;
+}
+
 static int read_data_continuous(void *opaque, uint8_t *buf, int buf_size)
 {
     struct playlist *v = opaque;
@@ -1751,6 +1845,7 @@ static int read_data_continuous(void *opaque, uint8_t *buf, int buf_size)
     int ret;
     int just_opened = 0;

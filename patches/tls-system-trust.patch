+/**
+ * Verify the peer certificate chain with the system trust store (SecTrust).
+ *
+ * OpenSSL built for Apple platforms has no trust store of its own: the
+ * OPENSSLDIR that SSL_CTX_set_default_verify_paths() points at does not exist
+ * on iOS, tvOS or visionOS (and is not the system store on macOS), so every
+ * verified handshake failed with "certificate verify failed". When no ca_file
+ * was given, this callback replaces OpenSSL's chain verification. With a
+ * cert_verify_callback installed OpenSSL does not run X509_verify_cert, so
+ * SecTrust is the only chain check and the only host name check (an
+ * SSL_set1_host call would not add a second one). The peer's leaf and
+ * intermediates are handed to SecTrust, which evaluates them against the
+ * system roots and user/MDM-installed anchors, with the platform's default
+ * revocation behaviour (best effort, not hard-fail). Its SSL policy checks the
+ * certificate against the host name we connect to (or the verifyhost
+ * override). This covers TLS and DTLS clients alike.
+ *
+ * SecTrustEvaluateWithError can block on the network (fetching intermediates
+ * through AIA, OCSP) and cannot be interrupted by the open's interrupt
+ * callback, so a caller should open the connection on a background queue.
+ */
+static int openssl_apple_verify_cert(X509_STORE_CTX *store, void *arg)
+{
+    URLContext *h = arg;
+    TLSContext *c = h->priv_data;
+    TLSShared *s = &c->tls_shared;
+    X509 *leaf = X509_STORE_CTX_get0_cert(store);
+    STACK_OF(X509) *chain = X509_STORE_CTX_get0_untrusted(store);
+    int nb_chain = chain ? sk_X509_num(chain) : 0;
+    CFMutableArrayRef certs = NULL;
+    CFStringRef host = NULL;
+    SecPolicyRef policy = NULL;
+    SecTrustRef trust = NULL;
+    CFErrorRef error = NULL;
+    int ok = 0;
+
+    certs = CFArrayCreateMutable(kCFAllocatorDefault, 0, &kCFTypeArrayCallBacks);
+    if (!certs || !leaf || !s->host)
+        goto end;
+    /* SecTrust takes the leaf first; the intermediates may follow in any order. */
+    for (int i = -1; i < nb_chain; i++) {
+        X509 *x = i < 0 ? leaf : sk_X509_value(chain, i);
+        unsigned char *der = NULL;
+        CFDataRef data = NULL;
+        SecCertificateRef cert = NULL;
+        int len;
+
+        if (i >= 0 && !X509_cmp(x, leaf))
+            continue;
+        len = i2d_X509(x, &der);
+        if (len > 0)
+            data = CFDataCreate(kCFAllocatorDefault, der, len);
+        OPENSSL_free(der);
+        if (data) {
+            cert = SecCertificateCreateWithData(kCFAllocatorDefault, data);
+            CFRelease(data);
+        }
+        if (!cert)
+            goto end;
+        CFArrayAppendValue(certs, cert);
+        CFRelease(cert);
+    }
+
+    host = CFStringCreateWithCString(kCFAllocatorDefault, s->host, kCFStringEncodingUTF8);
+    if (host)
+        policy = SecPolicyCreateSSL(true, host);
+    if (!policy || SecTrustCreateWithCertificates(certs, policy, &trust) != errSecSuccess)
+        goto end;
+    ok = SecTrustEvaluateWithError(trust, &error);
+
+end:
+    if (!ok) {
+        char reason[256] = "could not build the certificate chain";
+        CFStringRef desc = error ? CFErrorCopyDescription(error) : NULL;
+        if (desc) {
+            CFStringGetCString(desc, reason, sizeof(reason), kCFStringEncodingUTF8);
+            CFRelease(desc);
+        }
+        av_log(h, AV_LOG_ERROR, "System trust rejected the certificate of %s: %s\n",
+               s->host ? s->host : "?", reason);
+    }
+    X509_STORE_CTX_set_error(store, ok ? X509_V_OK : X509_V_ERR_CERT_UNTRUSTED);
+    if (error)
+        CFRelease(error);
+    if (trust)
+        CFRelease(trust);
+    if (policy)
+        CFRelease(policy);
+    if (host)
+        CFRelease(host);
+    if (certs)
+        CFRelease(certs);
+    return ok;
+}
+#endif

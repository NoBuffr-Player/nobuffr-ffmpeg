ass: size overflow fixes in sub_recode and ass_read_memory

Three libass master commits, not in any release yet:
- d4fa710 sub_recode reserved the NUL terminator inside an input-sized
  buffer, so an empty input with a codepage allocated zero bytes and wrote
  past it.
- 1f0f8e3 growing the sub_recode buffer could overflow size_t; the recode
  now fails instead of calling realloc with a wrapped size.
- fe25f50 ass_read_memory's bufsize + 1 wrapped to 0 for SIZE_MAX.

Applied ahead of a libass release because 0.17.5 is the newest release.

diff --git a/libass/ass.c b/libass/ass.c
index b9ce811..4162dce 100644
--- a/libass/ass.c
+++ b/libass/ass.c
@@ -1433,7 +1433,7 @@ static char *sub_recode(ASS_Library *library, char *data, size_t size,
 {
     iconv_t icdsc;
     char *tocp = "UTF-8";
-    char *outbuf;
+    char *outbuf = NULL;
     assert(codepage);
 
     if ((icdsc = iconv_open(tocp, codepage)) != (iconv_t) (-1)) {
@@ -1443,10 +1443,13 @@ static char *sub_recode(ASS_Library *library, char *data, size_t size,
         return NULL;
     }
 
+    if (size == SIZE_MAX)
+        goto out;
+
     {
-        size_t osize = size;
+        size_t osize = size + 1;
         size_t ileft = size;
-        size_t oleft = size - 1;
+        size_t oleft = size;
         char *ip;
         char *op;
         size_t rc;
@@ -1468,7 +1471,9 @@ static char *sub_recode(ASS_Library *library, char *data, size_t size,
             if (rc == (size_t) (-1)) {
                 if (errno == E2BIG) {
                     size_t offset = op - outbuf;
-                    char *nbuf = realloc(outbuf, osize + size);
+                    char *nbuf = NULL;
+                    if (size <= SIZE_MAX - osize)
+                        nbuf = realloc(outbuf, osize + size);
                     if (!nbuf) {
                         free(outbuf);
                         outbuf = 0;
@@ -1615,6 +1620,8 @@ ASS_Track *ass_read_memory(ASS_Library *library, char *buf,
     }
 #endif
     if (!copied) {
+        if (bufsize == SIZE_MAX)
+            return 0;
         char *newbuf = malloc(bufsize + 1);
         if (!newbuf)
             return 0;
